{
  "session-note": {
    "SessionStart": [
      {
        "type": "command",
        "command": "python3 ~/.gemini/config/hooks/session_start.py",
        "timeout": 5
      }
    ]
  },
  "assistant-stop-breadcrumb": {
    "Stop": [
      {
        "type": "command",
        "command": "python3 ~/.gemini/config/hooks/log_recent.py",
        "timeout": 5
      }
    ]
  },
  "code-guard-stop": {
    "Stop": [
      {
        "type": "command",
        "command": "python3 ~/.gemini/config/hooks/code_guard.py --mode stop",
        "timeout": 5
      }
    ]
  },
  "pii-push-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.gemini/config/hooks/pii_guard.py --mode agy",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
